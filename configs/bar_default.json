{
  "seed": 7,
  "hidden_dim": 32,
  "beta": 1.0,
  "support_threshold": 0.3,
  "graph": {"hop_limit": 3, "degree_cap": 50, "hub_edge_cap": 10, "guide_size": 20},
  "reasoning": {
    "min_budget": 2.0,
    "max_budget": 12.0,
    "query_cost": 1.0,
    "expand_cost": 0.5,
    "select_cost": 0.5,
    "prefilter_cap": 5,
    "evidence_cap": 8,
    "citation_cap": 5,
    "min_edges": 1,
    "min_quality": 0.1,
    "fallback_quality": 0.1,
    "stop_delta": 0.001,
    "stop_patience": 2
  },
  "training": {
    "baseline_epochs": 10,
    "warmup_epochs": 3,
    "policy_epochs": 3,
    "predictor_lr": 0.001,
    "policy_lr": 0.001,
    "gain_weight": 1.0,
    "cost_weight": 0.1,
    "integrity_weight": 0.25,
    "baseline_decay": 0.99
  }
